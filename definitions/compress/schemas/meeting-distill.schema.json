{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "decisions", "recurring_topics", "status_changes"],
  "properties": {
    "summary": { "type": "string", "maxLength": 600 },
    "decisions": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["date", "text", "source"],
        "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "text": { "type": "string", "maxLength": 240 }, "source": { "type": "string" }, "ticket": { "type": "string" } } }
    },
    "recurring_topics": {
      "type": "array", "maxItems": 8,
      "items": { "type": "object", "additionalProperties": false, "required": ["topic", "evidence"],
        "properties": { "topic": { "type": "string", "maxLength": 120 }, "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }
    },
    "status_changes": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["ticket", "to", "date"],
        "properties": { "ticket": { "type": "string" }, "to": { "type": "string" }, "date": { "type": "string" } } }
    }
  }
}
