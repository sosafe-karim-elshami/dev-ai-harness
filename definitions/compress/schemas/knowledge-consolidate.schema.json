{
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["op", "target", "reason", "evidence", "confidence"],
        "properties": {
          "op": { "enum": ["ADD", "UPDATE", "SUPERSEDE", "NOOP"] },
          "target": { "type": "string", "description": "rel path without .md (knowledge/...). For ADD, the proposed new path." },
          "superseded_by": { "type": "string", "description": "Required when op=SUPERSEDE: an existing or ADDed rel path." },
          "reason": { "type": "string", "maxLength": 300 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["note", "quote"],
            "properties": { "note": { "type": "string" }, "quote": { "type": "string", "maxLength": 240 } } } },
          "content": { "type": "string", "description": "Markdown body for ADD, or the section body for UPDATE." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
