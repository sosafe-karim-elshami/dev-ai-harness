{
  "schema_version": 2,
  "$comment": [
    "Retention policy v2 for the harness's own vault output. v1 only MOVED dated notes;",
    "v2 adds a rollup ladder (daily → weekly → monthly digests), distillation for",
    "meetings and knowledge, frontmatter TTLs, link rewriting on move, index budgets,",
    "and an audit log. Nothing is deleted, ever. `harness compress` (and `harness",
    "archive`, its rule-only subset) is a dry run unless given --apply."
  ],
  "default_after_days": 30,
  "date_from_default": [
    "filename-prefix",
    "frontmatter:date",
    "mtime"
  ],
  "folders": {
    "digests": {
      "strategy": "rollup",
      "recurse": false,
      "match": {
        "frontmatter_type": [
          "daily"
        ],
        "filename": "^\\d{4}-\\d{2}-\\d{2}"
      },
      "date_from": "filename-prefix",
      "ladder": [
        {
          "from": "daily",
          "to": "weekly",
          "after_days": 14,
          "period": "iso-week",
          "out_dir": "digests/weekly",
          "children_to": "digests/archive",
          "model": "haiku",
          "max_budget_usd": 0.6,
          "min_children": 2
        },
        {
          "from": "weekly",
          "to": "monthly",
          "after_days": 90,
          "period": "month",
          "out_dir": "digests/monthly",
          "children_to": "digests/archive/weekly",
          "model": "haiku",
          "max_budget_usd": 0.9,
          "min_children": 2
        }
      ],
      "budgets": {
        "max_live_files": 20
      },
      "exempt_types": [
        "compress-plan",
        "rollup"
      ],
      "note": "Dailies that are not type: daily (e.g. <date>-groom.md) and single-child weeks fall back to a plain archive move after 30 days."
    },
    "meetings": {
      "strategy": "distill",
      "recurse": false,
      "date_from": "filename-prefix",
      "after_days": 30,
      "group_by": "stem",
      "stem_pattern": "^\\d{4}-\\d{2}-\\d{2}-(.+?)(?:-(?:prep|notes|followup))?$",
      "period": "month",
      "out_dir": "meetings/rollups",
      "children_to": "meetings/archive",
      "promote": {
        "section": "Decisions",
        "to": "knowledge/decision-log.md"
      },
      "model": "sonnet",
      "max_budget_usd": 0.9,
      "budgets": {
        "max_live_files": 25
      },
      "note": "Recurring stems (ltc-daily, ltc-replenishment, …) distil into one note per stem per month; single-note stems archive without the LLM."
    },
    "monitoring": {
      "strategy": "archive",
      "after_days": 30,
      "date_from": "filename-prefix"
    },
    "growth": {
      "strategy": "archive",
      "after_days": 180,
      "recurse": true,
      "date_from": [
        "filename-prefix",
        "frontmatter:date"
      ],
      "exempt_filenames": [
        "idp-tracker.md"
      ],
      "note": "Evidence for performance conversations stays live far longer."
    },
    "knowledge": {
      "strategy": "distill",
      "recurse": true,
      "exclude_dirs": [
        "archive",
        "assets"
      ],
      "stale_after_days": 120,
      "updated_from": [
        "frontmatter:updated",
        "frontmatter:date",
        "mtime"
      ],
      "time_bound": {
        "ticket_key_pattern": "^(ltc|dx|sof|csa)-\\d+",
        "stale_after_days": 60,
        "frontmatter_types": [
          "plan",
          "tracker",
          "investigation"
        ]
      },
      "near_dupe_jaccard": 0.6,
      "archive_to": "knowledge/archive",
      "model": "sonnet",
      "max_budget_usd": 1.5,
      "budgets": {
        "max_live_files": 40
      },
      "note": "Topical, not chronological: nothing moves without a proposal (ADD | UPDATE | SUPERSEDE | NOOP) in the plan note, and only SUPERSEDE moves a file. `last_updated` is never a date source — it holds a time."
    },
    "memory": {
      "strategy": "keep",
      "note": "Durable by definition. `harness memory audit` surfaces candidates and never deletes."
    }
  },
  "frontmatter": {
    "expires_key": "expires",
    "status_key": "status",
    "superseded_value": "superseded",
    "superseded_by_key": "superseded_by",
    "pinned_key": "pinned",
    "archived_from_key": "archived_from"
  },
  "exempt": {
    "filenames": [
      "index.md",
      "How this works.md",
      "how-this-works.md",
      "memory-index.md",
      "decision-log.md"
    ],
    "rules": [
      "No resolvable date (per the date_from chain) → exempt, unless `expires:` is set.",
      "Today's date → never touched.",
      "Inside any archive/ folder → skip.",
      "`pinned: true` → exempt from everything, including index pruning.",
      "`expires: YYYY-MM-DD` in the past → archived regardless of folder strategy, even knowledge/.",
      "`status: superseded` → moved to <folder>/archive/ today, links rewritten, never deleted."
    ]
  },
  "index": {
    "file": "index.md",
    "recent_section": "## Recent",
    "recent_markers": [
      "<!-- harness:recent:begin -->",
      "<!-- harness:recent:end -->"
    ],
    "recent_count": 10,
    "max_index_lines": 120,
    "overflow_to": "knowledge/index.md",
    "importance": {
      "half_life_days": 90,
      "pinned_boost": 2.0,
      "star_boost": 1.5
    },
    "prune_links": true
  },
  "links": {
    "mode": "rewrite-on-move",
    "report_dangling": true,
    "fail_on_ambiguous_bare": true
  },
  "audit": {
    "log": "~/.claude/sosafe-harness/compress.jsonl",
    "plan_note": "digests/{date}-compress-plan.md"
  },
  "not_archived": {
    "runs.jsonl": "Read in full by `harness metrics` for all-time counts; never rotated.",
    "compress.jsonl": "The audit trail of this very policy. Append-only.",
    "graph.json": "Rebuilt wholesale by `harness graph build`.",
    "system.json": "Overwritten on every `harness sync`.",
    "workspace/": "Gitignored clones. Managed by `harness-workspace`, not retention."
  }
}
